<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Custom.ArgoX3API.WebAPI</RootNamespace>
    <AssemblyName>Custom.ArgoX3API.WebAPI</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="Assets\logo.png" />
  </ItemGroup>
  <ItemGroup>
    <_WebToolingArtifacts Remove="Properties\PublishProfiles\Prod.pubxml" />
    <_WebToolingArtifacts Remove="Properties\PublishProfiles\Test.pubxml" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Assets\logo.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Templates\email-template.html">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="MailKit" Version="5.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\ArgoX3API\ArgoX3API.WebApi.Shared\ArgoX3API.WebApi.Shared.csproj" />
    <ProjectReference Include="..\ArgoX3API.Application\Custom.ArgoX3API.Application.csproj" />
    <ProjectReference Include="..\ArgoX3API.Infrastructure\Custom.ArgoX3API.Infrastructure.csproj" />
    <ProjectReference Include="..\..\ArgoX3API\ArgoX3API.Logging\ArgoX3API.Logging.csproj" />
    <ProjectReference Include="..\SageX3.ClientLib\Custom.SageX3.ClientLib.csproj" />
    <ProjectReference Include="..\SageX3.WebServiceTypes\Custom.SageX3.WebServiceTypes.csproj" />
  </ItemGroup>
</Project>